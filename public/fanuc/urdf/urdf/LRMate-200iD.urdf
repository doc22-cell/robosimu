<?xml version="1.0" encoding="utf-8"?>
<!-- FANUC LR Mate 200iD browser-ready URDF.
     Mesh paths match public/fanuc/meshes/*.stl.
     Motion ranges are based on FANUC's published total motion ranges:
     J1 340, J2 245, J3 420, J4 380, J5 250, J6 720 degrees.
     Signed limits are represented symmetrically around zero because
     FANUC publishes these values as total ranges on its product page. -->
<robot name="LRMate-200iD">

  <link name="Base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://LRMate-200iD/meshes/base.stl"/></geometry>
    </visual>
  </link>

  <link name="J1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://LRMate-200iD/meshes/j1.stl"/></geometry>
    </visual>
  </link>
  <joint name="J1" type="revolute">
    <origin xyz="0 0 0.042741" rpy="0 0 0"/>
    <parent link="Base"/>
    <child link="J1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9671" upper="2.9671" effort="0" velocity="0"/>
  </joint>

  <link name="J2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://LRMate-200iD/meshes/j2.stl"/></geometry>
    </visual>
  </link>
  <joint name="J2" type="revolute">
    <origin xyz="0.05 0 0.28726" rpy="0 0 0"/>
    <parent link="J1"/>
    <child link="J2"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.1373" upper="2.1373" effort="0" velocity="0"/>
  </joint>

  <link name="J3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://LRMate-200iD/meshes/j3.stl"/></geometry>
    </visual>
  </link>
  <joint name="J3" type="revolute">
    <origin xyz="0 0 0.33" rpy="0 0 0"/>
    <parent link="J2"/>
    <child link="J3"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.6652" upper="3.6652" effort="0" velocity="0"/>
  </joint>

  <link name="J4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://LRMate-200iD/meshes/j4.stl"/></geometry>
    </visual>
  </link>
  <joint name="J4" type="revolute">
    <origin xyz="0.088001 0 0.035027" rpy="0 0 0"/>
    <parent link="J3"/>
    <child link="J4"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-3.3161" upper="3.3161" effort="0" velocity="0"/>
  </joint>

  <link name="J5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://LRMate-200iD/meshes/j5.stl"/></geometry>
    </visual>
  </link>
  <joint name="J5" type="revolute">
    <origin xyz="0.2454 0 0" rpy="0 0 0"/>
    <parent link="J4"/>
    <child link="J5"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.1817" upper="2.1817" effort="0" velocity="0"/>
  </joint>

  <link name="J6">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://LRMate-200iD/meshes/j6.stl"/></geometry>
    </visual>
  </link>
  <joint name="J6" type="revolute">
    <origin xyz="0.05 0 0" rpy="1.5708 0 0"/>
    <parent link="J5"/>
    <child link="J6"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-6.2832" upper="6.2832" effort="0" velocity="0"/>
  </joint>

</robot>
